# Copy this file to .env and fill it in:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# Generate each secret with:  python3 -c "import secrets; print(secrets.token_hex(32))"

# --- Required: docker compose will not start without these ---
SECRET_KEY=
JWT_SECRET_KEY=
POSTGRES_PASSWORD=
# Req 21: password for evoting_app, the web app's least-privilege database login
APP_DB_PASSWORD=

# --- Required: encryption key for voter details and backups (Req 8, 11) ---
AES_KEY=

# --- Optional: Req 2 and 3 timings, in seconds. Blank uses the report's values:
# a 15-minute idle timeout, and 5 failed attempts in 10 minutes lock the account
# for 15 minutes. Shorter values for a demo recording: 60, 3, 60, 5.
SESSION_TIMEOUT_SECONDS=
LOCKOUT_MAX_ATTEMPTS=
LOCKOUT_WINDOW_SECONDS=
LOCKOUT_SECONDS=

# --- Optional: email the voter when their details change (Req 13) ---
# Leave blank to run without email; the app then says the email could not be sent.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
