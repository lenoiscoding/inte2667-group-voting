# Copy this file to .env and fill it in:   cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# Generate each secret with:  python3 -c "import secrets; print(secrets.token_hex(32))"

# --- Required: docker compose will not start without these ---
SECRET_KEY=
JWT_SECRET_KEY=
POSTGRES_PASSWORD=

# --- Encryption key for voter details and backups (Req 8, 11): 64 hex characters ---
# Blank uses the built-in TEST key. Never use that for real data.
AES_KEY=

# --- Optional: email the voter when their details change (Req 13) ---
# Leave blank to run without email; the app then says the email could not be sent.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
